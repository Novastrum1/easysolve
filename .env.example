# Copy to .env. Local Compose defaults only; change credentials for production.
DATABASE_URL=
POSTGRES_PASSWORD=
# Exact browser origin, also used for CSRF and recovery links. Codespaces: https://CODESPACE-NAME-3000.app.github.dev
APP_URL=
# Generate: openssl rand -base64 32. Never change without rotating existing encrypted credentials.
TOKEN_ENCRYPTION_KEY=
# Shared server-only configuration for web and worker. Enter your key in root .env.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# disabled (default) or enabled; reasoning is never displayed.
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_MS=90000
# Connection testing is restricted to existing ADMIN-role accounts.
# Defaults: output 6000 (includes reasoning), input 200000 bytes, requests/min per user 20/global 60.
AI_MAX_OUTPUT_TOKENS=
AI_MAX_INPUT_BYTES=
AI_REQUESTS_PER_MINUTE=
AI_GLOBAL_REQUESTS_PER_MINUTE=
# Run-scoped AI requests are not stopped by token budgets. Execution remains bounded
# by AI_MAX_OUTPUT_TOKENS, AI_MAX_INPUT_BYTES, rate limits, RUN_TIMEOUT_MS, and
# AGENT_MAX_STEPS.
# Optional DeepSeek estimate prices per million; blank means no estimate, never a billing receipt.
# USD per million tokens. Blank means no estimate. See official pricing; rates vary by time.
DEEPSEEK_INPUT_PRICE_PER_MILLION=
DEEPSEEK_CACHED_PRICE_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=
# Server-enforced entitlement ceilings, per user and UTC calendar month.
PLAN_NAME=
PLAN_MAX_JOBS=
PLAN_MAX_TOKENS=
# Build with docker build -t easysolve-sandbox:local sandbox
SANDBOX_IMAGE=
# docker (default) for local hosts, or vercel for Vercel Sandbox with automatic OIDC auth.
SANDBOX_PROVIDER=
# Maximum active jobs across worker processes. Default 10.
WORKER_CONCURRENCY=
# Maximum active jobs for one account. Default 10.
WORKER_ACCOUNT_CONCURRENCY=
# Maximum model actions per coding run. Default 36; never set below 18.
AGENT_MAX_STEPS=
# Per-attempt wall-clock budget; checked between bounded provider/command operations.
RUN_TIMEOUT_MS=
# Optional authenticated email delivery adapter. POST {email,url}; return 2xx after acceptance.
RECOVERY_WEBHOOK_URL=
RECOVERY_WEBHOOK_SECRET=
# Set false only for local production-build tests over HTTP. Production HTTPS must use true.
COOKIE_SECURE=
# Optional explicit development seed. No example password is provided.
# SEED_EMAIL=you@example.com
# SEED_PASSWORD=

# Dedicated admin host routing; leave empty during Codespaces /admin development.
ADMIN_HOST=
# Exact HTTPS origin of the configured admin host; trusted for CSRF, never a wildcard.
ADMIN_ORIGIN=
# Mainnet requires BOTH this explicit server flag and an audited owner plan activation.
# Empty is disabled. Receiving addresses, network, price, duration and entitlements are versioned in PostgreSQL.
STELLAR_MAINNET_ACTIVATION=
# Read-only Horizon reconciliation operations per account/page (default 20, maximum 100).
PAYMENT_WATCH_BATCH=
