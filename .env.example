# Copy to .env. Local Compose defaults only; change credentials for production.
DATABASE_URL=
POSTGRES_PASSWORD=
# Exact browser origin, also used for CSRF and recovery links. Codespaces: https://CODESPACE-NAME-3000.app.github.dev
APP_URL=
# Generate: openssl rand -base64 32. Never change without rotating existing encrypted credentials.
TOKEN_ENCRYPTION_KEY=
# Server only. No key is needed to browse the app or use GitHub workflows.
# Select agentrouter or openai. Only the selected provider's key is used; no automatic fallback.
AI_PROVIDER=
# AgentRouter default URL: https://co.agentrouter.org/v1. Model has NO default: verify /models first.
AGENTROUTER_BASE_URL=
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=
# Default streaming deadline 90000ms (maximum 90000). No unverified reasoning parameters are sent.
AGENTROUTER_TIMEOUT_MS=
# Trusted operator User IDs allowed to test the selected provider (comma-separated).
AI_ADMIN_USER_IDS=
# Direct OpenAI remains a separate opt-in provider, with separate credentials and pricing.
OPENAI_API_KEY=
OPENAI_MODEL=
# Defaults: model gpt-6-astra; reasoning low (low | medium | high | xhigh | max).
# Astra does not support none. No fallback model is used.
OPENAI_TIMEOUT_MS=
OPENAI_REASONING_EFFORT=
# Comma-separated existing User IDs authorized to test the shared connection; empty denies everyone.
OPENAI_ADMIN_USER_IDS=
# Defaults: output 6000 (includes reasoning), input 200000 bytes, requests/min per user 20/global 60.
AI_MAX_OUTPUT_TOKENS=
AI_MAX_INPUT_BYTES=
AI_REQUESTS_PER_MINUTE=
AI_GLOBAL_REQUESTS_PER_MINUTE=
# Per run across retries: 500000 total tokens / 18 requests, plus RUN_TIMEOUT_MS below.
AI_JOB_MAX_TOKENS=
AI_JOB_MAX_REQUESTS=
# Optional OpenAI estimate prices per million; blank means no estimate, never a billing receipt.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_CACHED_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
# Server-enforced entitlement ceilings, per user and UTC calendar month.
PLAN_NAME=
PLAN_MAX_JOBS=
PLAN_MAX_TOKENS=
# Build with docker build -t easysolve-sandbox:local sandbox
SANDBOX_IMAGE=
# Maximum active jobs across worker processes. Each worker process executes one at a time.
WORKER_CONCURRENCY=
# Per-attempt wall-clock budget; checked between bounded provider/command operations.
RUN_TIMEOUT_MS=
# Optional authenticated email delivery adapter. POST {email,url}; return 2xx after acceptance.
RECOVERY_WEBHOOK_URL=
RECOVERY_WEBHOOK_SECRET=
# Set false only for local production-build tests over HTTP. Production HTTPS must use true.
COOKIE_SECURE=
# Optional explicit development seed. No example password is provided.
# SEED_EMAIL=you@example.com
# SEED_PASSWORD=
