{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "terminationGracePeriodSeconds": 1200
    }
  }
}
