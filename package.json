{
  "name": "easysolve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "worker": "tsx watch worker/index.ts",
    "start:all": "concurrently -k 'npm:dev' 'npm:worker'",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "setup": "node scripts/setup.mjs",
    "worker:start": "tsx worker/index.ts",
    "test:browser": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "doctor": "tsx scripts/doctor.ts",
    "format": "prettier --write app components lib worker tests scripts docs README.md",
    "ai:verify": "tsx scripts/verify-ai.ts",
    "agentrouter:verify": "tsx scripts/verify-agentrouter.ts",
    "bedrock:models": "tsx scripts/bedrock-models.ts",
    "billing:enable-mainnet": "tsx scripts/enable-live-checkout.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@next/env": "^16.4.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
