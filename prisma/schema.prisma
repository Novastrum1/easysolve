generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
enum Role {
 USER
 ADMIN
}
model User {
 id String @id @default(cuid())
 email String @unique
 name String
 password String
 createdAt DateTime @default(now())
 settings Json @default("{}")
 role Role @default(USER)
 suspendedAt DateTime?
 planName String?
 planMaxJobs Int?
 planMaxTokens Int?
 membershipPlan String @default("basic")
 proExpiresAt DateTime?
 proLifetime Boolean @default(false)
 issueLimitOverride Int?
 issueOverrideExpiresAt DateTime?
 githubLimitOverride Int?
 githubOverrideExpiresAt DateTime?
 allowanceResetAt DateTime @default(dbgenerated("'1970-01-01'::timestamp"))
 solveClaims SolveClaim[]
 invoices Invoice[]
 grants EntitlementGrant[]
 sessions Session[]
 identities Identity[]
 repos Repository[]
 issues Issue[]
 runs Run[]
 messages Message[]
 usage Usage[]
 aiRequests AIRequest[]
 proposals Proposal[]
 applications Application[]
 resets Reset[]
 jobs Job[]
}
model Session {
 id String @id
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 expiresAt DateTime
}
model Reset {
 id String @id
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime
}
model Identity {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 login String
 githubAccountId String?
 usable Boolean @default(true)
 token String
 active Boolean @default(true)
 status String @default("connected")
 syncedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([userId,login])
 @@unique([userId,githubAccountId])
}
model Repository {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 identityId String
 fullName String
 defaultBranch String @default("main")
 testCommand String @default("")
 stats Json @default("{}")
 health String @default("connected")
 createdAt DateTime @default(now())
 @@unique([userId,fullName])
}
model Issue {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 identityId String
 repo String
 number Int
 title String
 body String @default("")
 labels Json @default("[]")
 assignees Json @default("[]")
 state String @default("open")
 status String @default("ready")
 url String
 updatedAt DateTime @updatedAt
 createdAt DateTime @default(now())
 @@unique([userId,repo,number])
}
model Run {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 identityId String
 repo String
 issueIds Json
 title String
 status String @default("queued")
 branch String @unique
 baseSha String?
 headSha String?
 approvedSha String?
 feedback String @default("")
 plan String @default("")
 artifacts Json @default("{}")
 diff String @default("")
 logs String @default("")
 tests String @default("")
 error String?
 prNumber Int?
 prUrl String?
 mode String @default("approval")
 attempts Int @default(0)
 createdAt DateTime @default(now())
 startedAt DateTime?
 finishedAt DateTime?
 updatedAt DateTime @updatedAt
}
model Job {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 kind String
 key String @unique
 payload Json
 status String @default("queued")
 attempts Int @default(0)
 availableAt DateTime @default(now())
 leaseUntil DateTime?
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,availableAt])
}
model Message {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 conversation String @default("default")
 role String
 content String
 activity Json @default("[]")
 createdAt DateTime @default(now())
}
model Usage {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 runId String?
 provider String @default("openai")
 purpose String
 model String
 input Int
 cached Int @default(0)
 reasoning Int @default(0)
 output Int
 total Int
 createdAt DateTime @default(now())
 @@index([userId,runId])
}
model Proposal {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 identityId String
 repo String
 entries Json
 state String @default("preview")
 createdAt DateTime @default(now())
}
model Application {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 identityId String
 repo String
 number Int
 title String
 draft String
 wave String @default("")
 complexity String @default("moderate")
 languages Json @default("[]")
 status String @default("pending")
 createdAt DateTime @default(now())
}
model RateLimit {
 key String @id
 count Int @default(1)
 expiresAt DateTime
}

model ProviderConnection {
 id String @id
 fingerprint String
 model String
 verifiedAt DateTime
}

model AIRequest {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 runId String?
 createdAt DateTime @default(now())
 @@index([userId,runId])
}

model AdminAudit {
 id String @id @default(cuid())
 actorId String
 action String
 targetId String
 details Json @default("{}")
 reason String @default("")
 oldValues Json @default("{}")
 newValues Json @default("{}")
 createdAt DateTime @default(now())
 @@index([createdAt])
}

model AdminBootstrap {
 id String @id
 userId String
 createdAt DateTime @default(now())
}

model PlanVersion {
 id String @id @default(cuid())
 version Int @unique
 settings Json
 actorId String
 createdAt DateTime @default(now())
 invoices Invoice[]
}
model SolveClaim {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 issueId String
 runId String
 status String @default("reserved")
 succeededAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([userId,issueId])
 @@index([userId,status])
 @@index([runId])
}
model Invoice {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 planVersionId String
 planVersion PlanVersion @relation(fields:[planVersionId],references:[id])
 network String
 recipient String
 assetCode String
 issuer String
 amount String
 memo String @unique
 terms Json
 status String @default("pending")
 entitlementState String @default("pending")
 expiresAt DateTime
 createdAt DateTime @default(now())
 verifiedAt DateTime?
 payments PaymentReceipt[]
 submissions PaymentSubmission[]
 grants EntitlementGrant[]
 refundRequestedAt DateTime?
 refundStatus String @default("none")
 @@index([userId,createdAt])
 @@index([status])
}
model PaymentReceipt {
 id String @id @default(cuid())
 network String
 operationId String
 transactionHash String
 invoiceId String?
 invoice Invoice? @relation(fields:[invoiceId],references:[id])
 recipient String
 assetCode String
 issuer String
 amount String
 memo String?
 ledger Int
 paidAt DateTime
 status String
 detail String
 createdAt DateTime @default(now())
 @@unique([network,operationId])
 @@index([status])
}
model PaymentSubmission {
 id String @id @default(cuid())
 invoiceId String
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Cascade)
 transactionHash String
 status String @default("queued")
 attempts Int @default(0)
 availableAt DateTime @default(now())
 error String?
 createdAt DateTime @default(now())
 @@unique([invoiceId,transactionHash])
}
model EntitlementGrant {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 source String
 actorId String?
 reason String
 invoiceId String? @unique
 invoice Invoice? @relation(fields:[invoiceId],references:[id])
 startsAt DateTime @default(now())
 expiresAt DateTime?
 createdAt DateTime @default(now())
}
model PaymentCursor {
 id String @id
 network String
 recipient String
 cursor String @default("0")
 attempts Int @default(0)
 availableAt DateTime @default(now())
 error String?
 updatedAt DateTime @updatedAt
}
